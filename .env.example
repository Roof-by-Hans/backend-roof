
PORT= # 3000
SERVER_URL= # http://localhost:3000 (URL completa del servidor para Swagger y archivos estáticos)
JWT_SECRET= # Aca pueden poner lo que quieran
BCRYPT_SALT_ROUNDS= # 10 (cantidad de rondas para hashear con bcrypt)
JWT_EXPIRES_IN= # 1h (tiempo de expiración del JWT)
DB_HOST= # Host DB (IP)
DB_PORT= # Puerto DB
DB_USER= # Usuario de DB
DB_PASSWORD= # Contraseña DB
DB_NAME= # Nombre del schema (db en la que estamos trabajando)

# =========================
# Recuperación de contraseña (SMTP)
# =========================
# URL del frontend donde vive la pantalla de restablecer contraseña
# En desarrollo con Expo Web suele ser: http://localhost:8081
FRONTEND_URL= # http://localhost:8081

# Proveedor SMTP principal (ejemplo Gmail)
SMTP_HOST= # smtp.gmail.com
SMTP_PORT= # 587
SMTP_SECURE= # false (false para 587/TLS, true para 465/SSL)
SMTP_USER= # tu_correo@gmail.com
SMTP_PASS= # app_password_de_16_caracteres (NO la contraseña normal de Gmail)
SMTP_FROM= # Roof <tu_correo@gmail.com>

# Proveedor SMTP secundario (opcional, failover)
# Si no lo usan, dejar en blanco
SMTP_HOST_SECONDARY=
SMTP_PORT_SECONDARY=
SMTP_SECURE_SECONDARY=
SMTP_USER_SECONDARY=
SMTP_PASS_SECONDARY=

# Notas rápidas:
# 1) Para Gmail, activar 2FA y generar App Password.
# 2) Si FRONTEND_URL es incorrecta, el link del mail abrirá mal.
# 3) El backend guarda hash del token y maneja expiración automáticamente.